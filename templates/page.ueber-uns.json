    "multicolumn_values": {
      "type": "multicolumn",
      "blocks": {
        "col_1": {
          "type": "column",
          "settings": {
            "image": "",
            "title": "Gute und sichere Qualität",
            "text": "Bei Produkten, die täglich mit dir und deinem Baby in Berührung kommen, machen wir keine Kompromisse. Hochwertige Materialien, durchdachte Verarbeitung und sorgfältige Prüfung, plus 12 Monate Garantie zusätzlich zur gesetzlichen Gewährleistung.",
            "link_label": "",
            "link": ""
          }
        },
        "col_2": {
          "type": "column",
          "settings": {
            "image": "",
            "title": "Zeitloses Design",
            "text": "Babyprodukte müssen nicht nach Plastikspielzeug aussehen. Unsere Produkte sind schlicht, ruhig und modern gestaltet, damit sie sich in dein Zuhause einfügen und dir auch in einem Jahr noch gefallen.",
            "link_label": "",
            "link": ""
          }
        },
        "col_3": {
          "type": "column",
          "settings": {
            "image": "",
            "title": "Ein fairer Preis",
            "text": "Gute Qualität sollte sich jede Familie leisten können. Wir verkaufen direkt an dich, ohne Zwischenhändler, und können unsere Produkte deshalb zu einem fairen Preis anbieten.",
            "link_label": "",
            "link": ""
          }
        }
      },
      "block_order": [
        "col_1",
        "col_2",
        "col_3"
      ],
