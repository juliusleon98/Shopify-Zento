{{ 'component-zento-blocks.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- capture icon_grid -%}<circle cx="8" cy="8" r="2.3"/><circle cx="16" cy="8" r="2.3"/><circle cx="8" cy="16" r="2.3"/><circle cx="16" cy="16" r="2.3"/>{%- endcapture -%}
{%- capture icon_power -%}<path d="M12 4v7"/><path d="M7.2 7.4a7 7 0 1 0 9.6 0"/>{%- endcapture -%}
{%- capture icon_minus -%}<path d="M6 12h12"/>{%- endcapture -%}
{%- capture icon_plus -%}<path d="M6 12h12M12 6v12"/>{%- endcapture -%}
{%- capture icon_heart -%}<path d="M12 19s-6.5-4-6.5-9a3.8 3.8 0 0 1 6.5-2.3A3.8 3.8 0 0 1 18.5 10c0 5-6.5 9-6.5 9z"/>{%- endcapture -%}
{%- capture icon_drop -%}<path d="M12 4c3 4 5.5 6.6 5.5 9.6a5.5 5.5 0 0 1-11 0C6.5 10.6 9 8 12 4z"/>{%- endcapture -%}
{%- capture icon_cycle -%}<path d="M19 11a7 7 0 0 0-12.3-3.5L5 9.5"/><path d="M5 5v4.5h4.5"/><path d="M5 13a7 7 0 0 0 12.3 3.5L19 14.5"/><path d="M19 19v-4.5h-4.5"/>{%- endcapture -%}
{%- capture icon_letter_a -%}<path d="m6 19 6-14 6 14"/><path d="M8.6 14h6.8"/>{%- endcapture -%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="zento-display-guide page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="zento-display-guide__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="zento-display-guide__title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="zento-display-guide__inner">
      <div class="zento-display-guide__image">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200', alt: section.settings.image.alt }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="zento-display-guide__content">
        {%- assign keys = section.blocks | where: 'type', 'key' -%}
        {%- assign modes = section.blocks | where: 'type', 'mode' -%}

        {%- if keys.size > 0 -%}
          {%- if section.settings.keys_heading != blank -%}
            <h3 class="zento-display-guide__group">{{ section.settings.keys_heading | escape }}</h3>
          {%- endif -%}
          <ul class="zento-display-guide__keys" role="list">
            {%- for block in keys -%}
              <li class="zento-display-guide__key" {{ block.shopify_attributes }}>
                <span class="zento-display-guide__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    {%- case block.settings.icon -%}
                      {%- when 'grid' -%}{{ icon_grid }}
                      {%- when 'power' -%}{{ icon_power }}
                      {%- when 'minus' -%}{{ icon_minus }}
                      {%- when 'plus' -%}{{ icon_plus }}
                      {%- when 'heart' -%}{{ icon_heart }}
                      {%- when 'drop' -%}{{ icon_drop }}
                      {%- when 'cycle' -%}{{ icon_cycle }}
                      {%- when 'letter_a' -%}{{ icon_letter_a }}
                    {%- endcase -%}
                  </svg>
                </span>
                <span>{{ block.settings.label | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if modes.size > 0 -%}
          {%- if section.settings.modes_heading != blank -%}
            <h3 class="zento-display-guide__group">{{ section.settings.modes_heading | escape }}</h3>
          {%- endif -%}
          <ul class="zento-display-guide__modes" role="list">
            {%- for block in modes -%}
              <li class="zento-display-guide__mode" {{ block.shopify_attributes }}>
                <span class="zento-display-guide__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    {%- case block.settings.icon -%}
                      {%- when 'grid' -%}{{ icon_grid }}
                      {%- when 'power' -%}{{ icon_power }}
                      {%- when 'minus' -%}{{ icon_minus }}
                      {%- when 'plus' -%}{{ icon_plus }}
                      {%- when 'heart' -%}{{ icon_heart }}
                      {%- when 'drop' -%}{{ icon_drop }}
                      {%- when 'cycle' -%}{{ icon_cycle }}
                      {%- when 'letter_a' -%}{{ icon_letter_a }}
                    {%- endcase -%}
                  </svg>
                </span>
                <span>
                  <strong>{{ block.settings.heading | escape }}</strong>
                  {%- if block.settings.text != blank -%}<small>{{ block.settings.text | escape }}</small>{%- endif -%}
                </span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.note != blank -%}
          <p class="zento-display-guide__note">{{ section.settings.note | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Zento display guide",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Display image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Einfache Bedienung"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Alles im Griff mit nur vier Tasten"
    },
    {
      "type": "text",
      "id": "keys_heading",
      "label": "Heading of the buttons list",
      "default": "Bedientasten"
    },
    {
      "type": "text",
      "id": "modes_heading",
      "label": "Heading of the modes list",
      "default": "Betriebsmodi"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note below the lists",
      "default": "15 Intensitätsstufen in jedem Modus"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "key",
      "name": "Button",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "grid", "label": "Mode" },
            { "value": "power", "label": "Power" },
            { "value": "minus", "label": "Minus" },
            { "value": "plus", "label": "Plus" }
          ],
          "default": "grid"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        }
      ]
    },
    {
      "type": "mode",
      "name": "Mode",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "heart", "label": "Heart" },
            { "value": "drop", "label": "Drop" },
            { "value": "cycle", "label": "Cycle" },
            { "value": "letter_a", "label": "Letter A" }
          ],
          "default": "heart"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Short description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zento display guide",
      "blocks": [
        { "type": "key", "settings": { "icon": "grid", "label": "Modus" } },
        { "type": "key", "settings": { "icon": "power", "label": "Ein/Aus/Pause" } },
        { "type": "key", "settings": { "icon": "minus", "label": "Stufe senken" } },
        { "type": "key", "settings": { "icon": "plus", "label": "Stufe erhöhen" } },
        { "type": "mode", "settings": { "icon": "heart", "heading": "Massage", "text": "Sanfter Einstieg" } },
        { "type": "mode", "settings": { "icon": "drop", "heading": "Abpumpen", "text": "Gleichmäßig und kräftig" } },
        { "type": "mode", "settings": { "icon": "cycle", "heading": "Laktation", "text": "Wechselndes Tempo" } },
        { "type": "mode", "settings": { "icon": "letter_a", "heading": "Bionik", "text": "Rhythmus wie ein Baby" } }
      ]
    }
  ]
}
{% endschema %}
