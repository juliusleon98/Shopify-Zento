{% comment %}
  The highlight/feed review blocks below ship with placeholder example content (fictional names and
  quotes) so the section has something to preview. Replace every block's content with genuine customer
  reviews before this section goes live — displaying fabricated testimonials as real customer feedback
  is misleading to shoppers and can run afoul of consumer-protection law.
{% endcomment %}
{{ 'component-zento-blocks.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div id="zento-reviews-anchor" class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="zento-reviews page-width">
    <div class="zento-reviews__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="zento-reviews__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="zento-reviews__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="zento-reviews__top">
        <div>
          {%- liquid
            assign rating_sum = 0
            assign rating_count = 0
            for block in section.blocks
              assign rating_sum = rating_sum | plus: block.settings.rating
              assign rating_count = rating_count | plus: 1
            endfor
            assign use_auto = false
            if section.settings.auto_summary and rating_count > 0
              assign use_auto = true
              assign rating_avg = rating_sum | times: 1.0 | divided_by: rating_count
              assign rating_shown = rating_sum | times: 10 | divided_by: rating_count | divided_by: 10.0
              assign rating_rounded = rating_avg | round
            endif
          -%}
          <div class="zento-reviews__summary">
            {%- if use_auto -%}
              <div class="zento-reviews__score">{{ rating_shown | replace: '.', ',' }}</div>
              <div>
                <div class="zento-reviews__stars" aria-hidden="true">
                  {%- for i in (1..5) -%}{% if i <= rating_rounded %}★{% else %}☆{% endif %}{%- endfor -%}
                </div>
                <p>{% if rating_count == 1 %}1 Bewertung{% else %}{{ rating_count }} Bewertungen{% endif %}</p>
              </div>
            {%- else -%}
              <div class="zento-reviews__score">{{ section.settings.score }}</div>
              <div>
                <div class="zento-reviews__stars" aria-hidden="true">★★★★★</div>
                <p>{{ section.settings.review_count_text }}</p>
              </div>
            {%- endif -%}
          </div>
        </div>

        {%- if section.settings.button_label != blank -%}
          <modal-opener data-modal="#ZentoReviewModal-{{ section.id }}">
            <button type="button" class="zento-reviews__button" aria-haspopup="dialog">
              {{ section.settings.button_label | escape }}
            </button>
          </modal-opener>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="zento-reviews__slider" data-zento-reviews-slider>
          <div class="zento-reviews__track" tabindex="0" aria-label="Kundenbewertungen">
            {%- comment -%} Pass 1 renders the reviews with a photo, pass 2 the text-only ones. {%- endcomment -%}
            {%- for pass in (1..2) -%}
            {%- for block in section.blocks -%}
              {%- assign has_image = false -%}
              {%- if block.settings.image != blank -%}{%- assign has_image = true -%}{%- endif -%}
              {%- assign show_card = false -%}
              {%- if pass == 1 and has_image -%}
                {%- assign show_card = true -%}
              {%- elsif pass == 2 and has_image == false -%}
                {%- assign show_card = true -%}
              {%- endif -%}
              {%- if show_card == false -%}{%- continue -%}{%- endif -%}
              {%- if block.type == 'highlight_review' -%}
                {%- assign card_text = block.settings.quote -%}
                {%- assign card_meta = block.settings.author_label -%}
              {%- else -%}
                {%- assign card_text = block.settings.text -%}
                {%- assign card_meta = block.settings.date_text -%}
              {%- endif -%}
              {%- if card_meta == blank -%}{%- assign card_meta = section.settings.default_label -%}{%- endif -%}
              {%- comment -%} Show only "First L." when a full first and last name was entered. {%- endcomment -%}
              {%- assign card_name = block.settings.author_name | strip -%}
              {%- assign name_parts = card_name | split: ' ' -%}
              {%- if name_parts.size == 2 and name_parts[1].size > 2 -%}
                {%- assign last_initial = name_parts[1] | slice: 0 | upcase -%}
                {%- assign card_name = name_parts[0] | append: ' ' | append: last_initial | append: '.' -%}
              {%- endif -%}
              <article
                class="zento-reviews-card{% if block.settings.image != blank %} zento-reviews-card--with-image{% endif %}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.image != blank -%}
                  <div class="zento-reviews-card__image">
                    {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700' }}
                  </div>
                {%- endif -%}
                <div class="zento-reviews-card__body">
                  <div class="zento-reviews-card__stars" aria-hidden="true">
                    {%- for i in (1..5) -%}{% if i <= block.settings.rating %}★{% else %}☆{% endif %}{%- endfor -%}
                  </div>
                  <h3>{{ block.settings.heading | escape }}</h3>
                  <div class="zento-reviews-card__text">{{ card_text }}</div>
                  <div class="zento-reviews-card__author">
                    <span class="zento-reviews-card__avatar" aria-hidden="true">
                      {{- card_name | slice: 0 | upcase -}}
                    </span>
                    <span>
                      <strong>{{ card_name | escape }}</strong>
                      {%- if card_meta != blank -%}<small>{{ card_meta | escape }}</small>{%- endif -%}
                    </span>
                  </div>
                </div>
              </article>
            {%- endfor -%}
            {%- endfor -%}
          </div>
          <nav class="zento-reviews__nav" aria-label="Bewertungen durchblättern" data-zento-reviews-nav hidden>
            <button type="button" class="zento-reviews__page is-arrow" data-dir="-1" aria-label="Vorherige Bewertungen">&#8249;</button>
            <span class="zento-reviews__count" data-zento-reviews-count aria-live="polite"></span>
            <button type="button" class="zento-reviews__page is-arrow" data-dir="1" aria-label="Nächste Bewertungen">&#8250;</button>
          </nav>
        </div>
      {%- endif -%}

      <modal-dialog id="ZentoReviewModal-{{ section.id }}" class="zento-reviews-modal">
        <div
          role="dialog"
          aria-label="{{ section.settings.form_heading | escape }}"
          aria-modal="true"
          class="zento-reviews-modal__content"
          tabindex="-1"
        >
          <button
            id="ModalClose-{{ section.id }}"
            type="button"
            class="zento-reviews-modal__close"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {{- 'icon-close.svg' | inline_asset_content -}}
          </button>
          <div class="zento-reviews-form">
            <div class="zento-reviews-form__header">
              {%- if section.settings.form_eyebrow != blank -%}
                <p class="zento-reviews__eyebrow">{{ section.settings.form_eyebrow | escape }}</p>
              {%- endif -%}
              {%- if section.settings.form_heading != blank -%}
                <h2>{{ section.settings.form_heading | escape }}</h2>
              {%- endif -%}
              {%- if section.settings.form_text != blank -%}
                <p>{{ section.settings.form_text }}</p>
              {%- endif -%}
            </div>

            {% form 'contact' %}
          {% if form.posted_successfully? %}
            <div class="zento-reviews-form__success">
              {{ section.settings.form_success_text | escape }}
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="zento-reviews-form__error">
              {{ section.settings.form_error_text | escape }}
            </div>
          {% endif %}

          <input type="hidden" name="contact[Betreff]" value="Neue Produktbewertung für {{ product.title | default: shop.name }}">

          <div class="zento-reviews-form__grid">
            <div class="zento-reviews-form__field">
              <label for="review-name-{{ section.id }}">{{ 'templates.contact.form.name' | t }}</label>
              <input id="review-name-{{ section.id }}" type="text" name="contact[Name]" required>
            </div>

            <div class="zento-reviews-form__field">
              <label for="review-email-{{ section.id }}">{{ 'templates.contact.form.email' | t }}</label>
              <input id="review-email-{{ section.id }}" type="email" name="contact[email]" required>
            </div>
          </div>

          <div class="zento-reviews-form__grid">
            <div class="zento-reviews-form__field">
              <label for="review-rating-{{ section.id }}">Bewertung</label>
              <select id="review-rating-{{ section.id }}" name="contact[Bewertung]" required>
                <option value="">Sterne auswählen</option>
                <option value="5 Sterne">★★★★★ 5</option>
                <option value="4 Sterne">★★★★☆ 4</option>
                <option value="3 Sterne">★★★☆☆ 3</option>
                <option value="2 Sterne">★★☆☆☆ 2</option>
                <option value="1 Stern">★☆☆☆☆ 1</option>
              </select>
            </div>

            <div class="zento-reviews-form__field">
              <label for="review-title-{{ section.id }}">Titel der Bewertung</label>
              <input id="review-title-{{ section.id }}" type="text" name="contact[Titel der Bewertung]" required>
            </div>
          </div>

          <div class="zento-reviews-form__field">
            <label for="review-message-{{ section.id }}">Deine Bewertung</label>
            <textarea id="review-message-{{ section.id }}" name="contact[body]" rows="5" required></textarea>
          </div>

          <button type="submit" class="zento-reviews-form__button">
            {{ section.settings.form_submit_label | escape }}
          </button>
            {% endform %}
          </div>
        </div>
      </modal-dialog>
    </div>
  </div>
</div>

<script>
  (function () {
    function setup(slider) {
      if (slider.dataset.sliderReady) return;
      slider.dataset.sliderReady = '1';
      var track = slider.querySelector('.zento-reviews__track');
      var nav = slider.querySelector('[data-zento-reviews-nav]');
      var count = slider.querySelector('[data-zento-reviews-count]');
      var prev = nav.querySelector('[data-dir="-1"]');
      var next = nav.querySelector('[data-dir="1"]');
      var cards = Array.prototype.slice.call(track.children);

      function visibleRange() {
        var box = track.getBoundingClientRect();
        var first = 0;
        var last = 0;
        var seen = false;
        cards.forEach(function (card, i) {
          var r = card.getBoundingClientRect();
          var shown = Math.min(r.right, box.right) - Math.max(r.left, box.left);
          if (shown > r.width * 0.6) {
            if (!seen) { first = i; seen = true; }
            last = i;
          }
        });
        return { first: first, last: last };
      }

      function update() {
        var range = visibleRange();
        var atStart = track.scrollLeft <= 2;
        var atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
        nav.hidden = atStart && atEnd;
        prev.disabled = atStart;
        next.disabled = atEnd;
        var from = atStart ? 1 : range.first + 1;
        var to = atEnd ? cards.length : range.last + 1;
        count.textContent = (from === to ? from : from + '\u2013' + to) + ' von ' + cards.length;
      }

      nav.addEventListener('click', function (event) {
        var btn = event.target.closest('[data-dir]');
        if (!btn || btn.disabled) return;
        var step = cards[0].getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap || 0);
        var per = Math.max(1, Math.floor(track.clientWidth / step));
        track.scrollBy({ left: parseInt(btn.dataset.dir, 10) * step * per, behavior: 'smooth' });
      });

      track.addEventListener('scroll', function () { window.requestAnimationFrame(update); }, { passive: true });
      window.addEventListener('resize', update);
      update();
    }

    function init(root) {
      root.querySelectorAll('[data-zento-reviews-slider]').forEach(setup);
    }

    init(document);
    if (!window.zentoReviewsSliderBound) {
      window.zentoReviewsSliderBound = true;
      document.addEventListener('shopify:section:load', function (event) { init(event.target); });
    }
  })();
</script>

{% schema %}
{
  "name": "Zento reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "KUNDENBEWERTUNGEN"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Was Mamas über Zento sagen"
    },
    {
      "type": "text",
      "id": "score",
      "label": "Score",
      "default": "4,8"
    },
    {
      "type": "text",
      "id": "review_count_text",
      "label": "Review count text",
      "default": "Basierend auf 20 Bewertungen"
    },
    {
      "type": "checkbox",
      "id": "auto_summary",
      "label": "Calculate rating and number of reviews from the reviews below",
      "info": "On: the score and the count are computed from the active review blocks, so they always match what is shown. Off: the two manual fields above are used.",
      "default": true
    },
    {
      "type": "text",
      "id": "default_label",
      "label": "Label under the name",
      "info": "Shown on every review that has no own label or date. Only use \"Verifizierte Kundin\" for reviews from real, verified purchases.",
      "default": "Verifizierte Kundin"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "\"Write a review\" button label",
      "default": "Bewertung schreiben"
    },
    {
      "type": "header",
      "content": "Review form"
    },
    {
      "type": "text",
      "id": "form_eyebrow",
      "label": "Form eyebrow",
      "default": "DEINE ERFAHRUNG"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Bewertung schreiben"
    },
    {
      "type": "richtext",
      "id": "form_text",
      "label": "Form intro text",
      "default": "<p>Teile deine Erfahrung mit Zento. Deine Bewertung hilft anderen Mamas bei ihrer Entscheidung.</p>"
    },
    {
      "type": "text",
      "id": "form_submit_label",
      "label": "Submit button label",
      "default": "Bewertung abschicken"
    },
    {
      "type": "text",
      "id": "form_success_text",
      "label": "Success message",
      "default": "Danke für deine Bewertung. Wir prüfen sie und veröffentlichen sie anschließend."
    },
    {
      "type": "text",
      "id": "form_error_text",
      "label": "Error message",
      "default": "Bitte prüfe deine Eingaben und versuche es erneut."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 76
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 76
    }
  ],
  "blocks": [
    {
      "type": "highlight_review",
      "name": "Highlight review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author name"
        },
        {
          "type": "text",
          "id": "author_label",
          "label": "Author label",
          "default": "Verifizierte Kundin"
        }
      ]
    },
    {
      "type": "feed_review",
      "name": "Feed review",
      "settings": [
        {
          "type": "text",
          "id": "author_name",
          "label": "Author name"
        },
        {
          "type": "text",
          "id": "date_text",
          "label": "Date text"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zento reviews",
      "blocks": [
        { "type": "highlight_review" },
        { "type": "highlight_review" },
        { "type": "highlight_review" },
        { "type": "feed_review" },
        { "type": "feed_review" }
      ]
    }
  ]
}
{% endschema %}
